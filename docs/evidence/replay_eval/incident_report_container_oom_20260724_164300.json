  "remediation_plan": {
    "plan_id": "PLAN-7D154B7F",
    "root_cause_category": "container_oom",
    "risk_level": "medium",
    "approval_required": true,
    "steps": [
      {
        "order": 1,
        "action": "回滚可疑变更 CHG-20260723-0021，移除内存膨胀源",
        "action_type": "rollback_change",
        "command": "kubectl rollout undo deployment/payment-service -n prod",
        "expected_effect": "内存增长曲线恢复平稳"
      },
      {
        "order": 2,
        "action": "临时上调容器内存 limit，提供恢复缓冲",
        "action_type": "config_update",
        "command": "kubectl patch deployment payment-service -n prod --patch '{\"spec\":{\"template\":{\"spec\":{\"containers\":[{\"name\":\"payment-service\",\"resources\":{\"limits\":{\"memory\":\"6Gi\"}}}]}}}}'",
        "expected_effect": "短期内不再触发 OOMKilled"
      },
      {
        "order": 3,
        "action": "重启后采集 heap dump 留存证据，供复盘分析",
        "action_type": "diagnostic_capture",
        "command": "kubectl exec deploy/payment-service -n prod -- jmap -dump:live,file=/tmp/heap.hprof 1",
        "expected_effect": "获得内存快照，定位具体泄漏对象"
      }
    ],
    "rollback_plan": [
      {
        "order": 1,
        "action": "若回滚后仍持续 OOM，恢复内存 limit 原值并升级人工介入",
        "action_type": "config_update",
        "command": "kubectl patch deployment payment-service -n prod --patch '{\"spec\":{\"template\":{\"spec\":{\"containers\":[{\"name\":\"payment-service\",\"resources\":{\"limits\":{\"memory\":\"4Gi\"}}}]}}}}'",
        "expected_effect": "配置回到基线"
      }
    ],
