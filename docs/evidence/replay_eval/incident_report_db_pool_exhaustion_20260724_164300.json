  "remediation_plan": {
    "plan_id": "PLAN-730D0A2B",
    "root_cause_category": "db_pool_exhaustion",
    "risk_level": "medium",
    "approval_required": true,
    "steps": [
      {
        "order": 1,
        "action": "回滚可疑变更 CHG-20260723-0012，下线泄漏代码",
        "action_type": "rollback_change",
        "command": "kubectl rollout undo deployment/order-service -n prod",
        "expected_effect": "连接泄漏源头消除，池占用逐步回落"
      },
      {
        "order": 2,
        "action": "临时调大连接池上限，缓解恢复期请求排队",
        "action_type": "scale_pool",
        "command": "kubectl set env deployment/order-service -n prod HIKARI_MAXIMUM_POOL_SIZE=50",
        "expected_effect": "恢复期内连接获取超时减少"
      },
      {
        "order": 3,
        "action": "滚动重启实例，强制释放已泄漏连接",
        "action_type": "rolling_restart",
        "command": "kubectl rollout restart deployment/order-service -n prod",
        "expected_effect": "存量泄漏连接全部回收，错误率归零"
      }
    ],
    "rollback_plan": [
      {
        "order": 1,
        "action": "若回滚后 30 分钟错误率未下降，重新发布当前版本并升级人工介入",
        "action_type": "rollback_change",
        "command": "kubectl rollout undo deployment/order-service -n prod --to-revision=<current>",
        "expected_effect": "恢复初始状态，保留现场供人工排查"
      },
      {
        "order": 2,
        "action": "恢复连接池参数为原值",
        "action_type": "config_update",
        "command": "kubectl set env deployment/order-service -n prod HIKARI_MAXIMUM_POOL_SIZE=20",
        "expected_effect": "配置回到基线，避免掩盖问题"
      }
    ],
